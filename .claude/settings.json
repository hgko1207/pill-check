{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "team-ai-kit": {
      "source": {
        "source": "github",
        "repo": "hgko1207/team-ai-kit"
      }
    }
  },
  "enabledPlugins": {
    "team-ai@team-ai-kit": true
  },
  "permissions": {
    "allow": [
      "Bash(git status *)", "PowerShell(git status *)",
      "Bash(git diff *)",
      "PowerShell(git diff *)",
      "Bash(git log *)",
      "PowerShell(git log *)",
      "Bash(git show *)",
      "PowerShell(git show *)",
      "Bash(git fetch *)",
      "PowerShell(git fetch *)",
      "Bash(git branch --show-current)",
      "PowerShell(git branch --show-current)",
      "Bash(git rev-parse *)",
      "PowerShell(git rev-parse *)",
      "Bash(git add *)",
      "PowerShell(git add *)",
      "Bash(npm --prefix web run typecheck)", "PowerShell(npm --prefix web run typecheck)",
      "Bash(npm --prefix web run build)", "PowerShell(npm --prefix web run build)",
      "Bash(npm run typecheck)", "PowerShell(npm run typecheck)",
      "Bash(npm run build)", "PowerShell(npm run build)"
    ],
    "ask": [
      "Bash(git add -A *)", "PowerShell(git add -A *)",
      "Bash(git add . *)",
      "PowerShell(git add . *)",
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Bash(git reset *)",
      "PowerShell(git reset *)",
      "Bash(git clean *)",
      "PowerShell(git clean *)",
      "Bash(git restore *)",
      "PowerShell(git restore *)",
      "Bash(git checkout -- *)",
      "PowerShell(git checkout -- *)",
      "Bash(git stash drop *)",
      "PowerShell(git stash drop *)",
      "Bash(git branch -D *)",
      "PowerShell(git branch -D *)",
      "Bash(git rebase *)",
      "PowerShell(git rebase *)",
      "Bash(rm -r *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "PowerShell(Remove-Item *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production*)",
      "Read(**/.env.development*)",
      "Read(**/.env.staging*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/id_rsa*)",
      "Read(**/secrets/**)",
      "Read(**/.npmrc)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.production*)",
      "Edit(**/.env.development*)",
      "Edit(**/.env.staging*)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/secrets/**)",
      "Edit(**/*.pfx)",
      "Edit(**/*.p12)",
      "Edit(**/id_rsa*)",
      "Edit(**/.npmrc)"
    ],
    "disableBypassPermissionsMode": "disable"
  }
}
